NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: enables Freesound search in the Sounds panel.
FREESOUND_API_KEY=

# Optional: enables distributed rate limiting for the sound-search API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
